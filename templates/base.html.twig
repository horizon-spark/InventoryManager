<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Мой проект на Symfony{% endblock %}</title>
    
    <!-- Подключение Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Индивидуальный проект</a>
        </div>
    </nav>

    <main class="container">
        <!-- Глобальный вывод Flash-сообщений (уведомлений) -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Основной контент дочерних страниц -->
        {% block body %}{% endblock %}
    </main>

    <footer class="container mt-5 border-top pt-3 text-muted">
        &copy; {{ 'now'|date('Y') }} Лабораторная работа №3
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>