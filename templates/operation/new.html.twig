{% extends 'base.html.twig' %}

{% block title %}Добавление операции{% endblock %}

{% block body %}
    <h1>Создать новую операцию</h1>

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.type) }}
                {{ form_widget(form.type) }}
                <div class="text-danger">{{ form_errors(form.type) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.product) }}
                {{ form_widget(form.product) }}
                <div class="text-danger">{{ form_errors(form.product) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.warehouse) }}
                {{ form_widget(form.warehouse) }}
                <div class="text-danger">{{ form_errors(form.warehouse) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.quantity) }}
                {{ form_widget(form.quantity) }}
                <div class="text-danger">{{ form_errors(form.quantity) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.comment) }}
                {{ form_widget(form.comment) }}
                <div class="text-danger">{{ form_errors(form.comment) }}</div>
            </div>

            {{ form_row(form.save) }}
            {{ form_end(form) }}

            <a href="{{ path('operation_list') }}" class="btn btn-link mt-3">Вернуться к списку</a>
        </div>
    </div>
{% endblock %}