{% extends 'base.html.twig' %}

{% block title %}Список товаров{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Оборудование (товары)</h1>
        <a href="{{ path('product_create') }}" class="btn btn-primary">Добавить товар</a>
    </div>

    {# Поиск по имени (бывший /filter) #}
    <form method="get" action="{{ path('product_list') }}" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="text" name="name" value="{{ name }}" class="form-control"
                   placeholder="Поиск по названию">
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-secondary">Найти</button>
            {% if name %}
                <a href="{{ path('product_list') }}" class="btn btn-link">Сбросить</a>
            {% endif %}
        </div>
        <div class="col-auto">
            <a href="{{ path('product_list', {archived: archived ? 0 : 1, name: name}) }}"
               class="btn {{ archived ? 'btn-warning' : 'btn-outline-secondary' }}">
                {{ archived ? '← К активным' : 'Показать архив' }}
            </a>
        </div>
    </form>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>#</th>
            <th>Название</th>
            <th>Артикул (SKU)</th>
            <th>Цена</th>
            <th>Категория</th>
            <th>Статус</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ product.name }}</td>
                <td>{{ product.sku }}</td>
                <td>{{ product.price }}</td>
                <td>{{ product.category ? product.category.name : 'Без категории' }}</td>
                <td>
                    {% if product.archived %}
                        <span class="badge bg-secondary">В архиве</span>
                    {% else %}
                        <span class="badge bg-success">Активен</span>
                    {% endif %}
                </td>
                <td class="text-nowrap">
                    <a href="{{ path('product_show', {id: product.id}) }}"
                       class="btn btn-sm btn-outline-primary">Открыть</a>

                    {% if not product.archived %}
                        <a href="{{ path('product_edit', {id: product.id}) }}"
                           class="btn btn-sm btn-outline-secondary">Ред.</a>

                        <form method="post"
                              action="{{ path('product_delete', {id: product.id}) }}"
                              class="d-inline-block"
                              onsubmit="return confirm('Переместить товар «{{ product.name|e('js') }}» в архив?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete_product_' ~ product.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">В архив</button>
                        </form>
                    {% else %}
                        <form method="post"
                              action="{{ path('product_restore', {id: product.id}) }}"
                              class="d-inline-block"
                              onsubmit="return confirm('Восстановить товар «{{ product.name|e('js') }}»?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('restore_product_' ~ product.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-success">Восстановить</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center text-muted">Записи не найдены</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}