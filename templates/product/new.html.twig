{% extends 'base.html.twig' %}

{% block title %}Добавление товара{% endblock %}

{% block body %}
    <h1>Создать новую запись</h1>

    <div class="card mt-4">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                <div class="text-danger">{{ form_errors(form.name) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.sku) }}
                {{ form_widget(form.sku) }}
                <div class="text-danger">{{ form_errors(form.sku) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.price) }}
                {{ form_widget(form.price) }}
                <div class="text-danger">{{ form_errors(form.price) }}</div>
            </div>

            <div class="mb-3">
                {{ form_label(form.category) }}
                {{ form_widget(form.category) }}
                <div class="text-danger">{{ form_errors(form.category) }}</div>
            </div>

            {{ form_row(form.save) }}
            {{ form_end(form) }}

            <a href="{{ path('product_list') }}" class="btn btn-link mt-3">Вернуться к списку</a>
        </div>
    </div>
{% endblock %}