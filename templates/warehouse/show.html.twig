{% extends 'base.html.twig' %}

{% block title %}Склад #{{ warehouse.id }}{% endblock %}

{% block body %}
    <h1>{{ warehouse.name }}</h1>

    <dl class="row mt-4">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">{{ warehouse.id }}</dd>

        <dt class="col-sm-3">Название</dt>
        <dd class="col-sm-9">{{ warehouse.name }}</dd>

        <dt class="col-sm-3">Расположение</dt>
        <dd class="col-sm-9">{{ warehouse.location|default('—') }}</dd>

        <dt class="col-sm-3">Операций</dt>
        <dd class="col-sm-9">{{ warehouse.operations|length }}</dd>
    </dl>

    <a href="{{ path('warehouse_list') }}" class="btn btn-link">← К списку</a>
{% endblock %}